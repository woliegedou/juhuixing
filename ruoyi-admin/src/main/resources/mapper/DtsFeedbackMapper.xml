<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.ruoyi.program.mapper.DtsFeedbackMapper">
    <resultMap id="BaseResultMap" type="com.ruoyi.program.entity.DtsFeedback">
        <id column="id" property="id" jdbcType="INTEGER"/>
        <result column="user_id" property="userId" javaType="INTEGER"/>
        <result column="username" property="username" javaType="STRING"/>
        <result column="mobile" property="mobile" javaType="STRING"/>
        <result column="feed_type" property="feedType" javaType="STRING"/>
        <result column="content" property="content" javaType="STRING"/>
        <result column="status" property="status" javaType="INTEGER"/>
        <result column="has_picture" property="hasPicture" javaType="INTEGER"/>
        <result column="pic_urls" property="picUrls" javaType="STRING"/>
        <result column="created_by" property="createdBy" javaType="STRING"/>
        <result column="created_time" property="createdTime" javaType="DATE"/>
        <result column="updated_by" property="updatedBy" javaType="STRING"/>
        <result column="updated_time" property="updatedTime" javaType="DATE"/>
        <result column="is_delete" property="isDelete" javaType="INTEGER"/>
    </resultMap>
    <select id="selectDtsFeedbackList" resultMap="BaseResultMap">
        select id, user_id, username, mobile, feed_type, content, status, has_picture, pic_urls, created_by,
        created_time, updated_by, updated_time, is_delete
        from dts_feedback
        <where>
            <if test="id != null">
               and id = #{id}
            </if>
            <if test="userId != null">
                and user_id like CONCAT('%', #{userId}, '%')
            </if>
            <if test="username != null">
                and username like CONCAT('%', #{username}, '%')
            </if>
            <if test="mobile != null">
                and mobile = #{mobile}
            </if>
            <if test="feedType != null">
                and feed_type = #{feedType}
            </if>
            <if test="content != null">
                and content = #{content}
            </if>
            <if test="status != null">
                and status = #{status}
            </if>
            <if test="hasPicture != null">
                and has_picture = #{hasPicture}
            </if>
            <if test="picUrls != null">
                and pic_urls = #{picUrls}
            </if>
            <if test="createdBy != null">
                and created_by = #{createdBy}
            </if>
            <if test="createdTime != null">
                and created_time = #{createdTime}
            </if>
            <if test="updatedBy != null">
                and updated_by = #{updatedBy}
            </if>
            <if test="updatedTime != null">
                and updated_time = #{updatedTime}
            </if>
            <if test="isDelete != null">
                and is_delete = #{isDelete}
            </if>
        </where>
    </select>
</mapper>